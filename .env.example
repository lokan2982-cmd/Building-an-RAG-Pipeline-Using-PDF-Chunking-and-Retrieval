# ============================================================
# RAG Pipeline - Local Ollama Configuration Template
# Works 100% offline once Ollama models are downloaded.
# No OpenAI or Azure OpenAI API keys are required.
#
# Copy this file to .env if you want to customise defaults:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
# ============================================================

# ----- Ollama Local Server & Models -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0

# ----- RAG Chunking & Retrieval Configuration -----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=3

# ----- Project Paths (relative to project root) -----
PDF_DIR=data/pdfs
VECTORSTORE_PATH=vectorstore
